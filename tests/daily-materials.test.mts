import {test} from 'node:test';
import assert from 'node:assert/strict';
import {DatabaseSync} from 'node:sqlite';
import {readFileSync,readdirSync} from 'node:fs';
// @ts-ignore Native Node type stripping
import {dayTokenSql,dayTokenBinds} from '../src/modules/production/daily-material-domain.ts';
function fixture(){const db=new DatabaseSync(':memory:');for(const file of readdirSync(new URL('../drizzle/',import.meta.url)).filter(f=>/^\d+.*\.sql$/.test(f)).sort())db.exec(readFileSync(new URL('../drizzle/'+file,import.meta.url),'utf8'));db.exec("INSERT INTO customers VALUES('c','DEMO','','',''); INSERT INTO products(id,hu,ro,description_hu,description_ro,category,price,portion,allergens) VALUES('p','DEMO','DEMO','','','main',1000,100,''); INSERT INTO production_batches(id,day,product_id,code,created_by,created_at) VALUES('b','2026-11-06','p','DEMO','test','now')");return db;}
test('Ready portions can exist under the accounting profile before the daily handover, only with a material snapshot',()=>{const db=fixture();try{db.exec("INSERT INTO accounting_profile VALUES(1,'non_vat_payer','','2026-11-06',1,'test','now')");assert.throws(()=>db.exec("UPDATE production_batches SET status='closed',actual=10 WHERE id='b'"),/ACCOUNTING_HANDOVER_REQUIRED/);db.exec("INSERT INTO production_materials(batch_id,day,content) VALUES('b','2026-11-06','{}'); UPDATE production_batches SET status='closed',actual=10 WHERE id='b'");assert.equal(db.prepare('SELECT actual FROM production_batches').get()?.actual,10);assert.equal(db.prepare('SELECT COUNT(*) AS n FROM stock_moves').get()?.n,0);assert.equal(db.prepare('SELECT COUNT(*) AS n FROM consumption_documents').get()?.n,0);}finally{db.close()}});
test('Daily preview token changes for production, ready material, orders and earlier-day close revisions',()=>{const db=fixture();try{const token=()=>db.prepare(dayTokenSql).get(...dayTokenBinds('2026-11-06'))?.token;let prev=token();db.exec("UPDATE production_batches SET revision=revision+1 WHERE id='b'");assert.notEqual(token(),prev);prev=token();db.exec("INSERT INTO production_materials(batch_id,day,content) VALUES('b','2026-11-06','{}')");assert.notEqual(token(),prev);prev=token();db.exec("INSERT INTO orders(id,customer_id,customer_name,address,phone,date,time,note,created_at) VALUES('o','c','DEMO','','','2026-11-06','12:00','','now')");assert.notEqual(token(),prev);prev=token();db.exec("INSERT INTO production_day_closes(day,status,content) VALUES('2026-11-05','open','{}')");assert.notEqual(token(),prev);prev=token();db.exec("UPDATE production_day_closes SET revision=revision+1 WHERE day='2026-11-05'");assert.notEqual(token(),prev);}finally{db.close()}});
test('Closed days reject a racing new batch or changed finished quantity but permit material reversal bookkeeping',()=>{const db=fixture();try{db.exec("INSERT INTO production_day_closes(day,status,content) VALUES('2026-11-06','closed','{}')");assert.throws(()=>db.exec("UPDATE production_batches SET actual=2 WHERE id='b'"),/DAY_CLOSED/);assert.throws(()=>db.exec("INSERT INTO production_batches(id,day,product_id,code,created_by,created_at) VALUES('b2','2026-11-06','p','D2','test','now')"),/DAY_CLOSED/);db.exec("UPDATE production_batches SET consumption_id=NULL,revision=revision+1 WHERE id='b'");assert.equal(db.prepare("SELECT revision FROM production_batches WHERE id='b'").get()?.revision,1);}finally{db.close()}});

// @ts-ignore Native Node type stripping
import {procurementPlan,forwardProcurement,emptyOperations} from '../src/modules/inventory/domain.ts';
test('Pending daily material is included once in purchasing without changing the raw-stock ledger',()=>{
 const ops={...emptyOperations,ingredients:[{id:'i',packQuantity:100,packPrice:1000,minStock:0}],lots:[{id:'l',ingredientId:'i',remaining:100,received:'2026-11-06',expires:'2026-11-08'}],deferredNeeds:[{day:'2026-11-06',ingredientId:'i',quantity:180}]} as never;
 const row=procurementPlan([],ops,'2026-11-06').rows[0];assert.equal(row.required,180);assert.equal(row.available,100);assert.equal(row.shortage,80);
 const forecast=forwardProcurement([],ops,'2026-11-06',3);assert.equal(forecast.length,1);assert.equal(forecast[0].shortage[0].quantity,80);assert.equal((ops as {lots:{remaining:number}[]}).lots[0].remaining,100);
});
